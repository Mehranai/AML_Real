# API_BIND_ADDRESS may be the VM private IP. Keep DATABASE_BIND_ADDRESS on loopback.
API_BIND_ADDRESS=10.20.0.22
DATABASE_BIND_ADDRESS=127.0.0.1
ETHEREUM_API_PORT=5001
CLICKHOUSE_HTTP_PORT=28123
CLICKHOUSE_NATIVE_PORT=29000
# Neo4j is configured only in the main VM .env.

# Main-VM to chain-VM authentication. Enable in shared/production deployments.
AML_SERVICE_AUTH_REQUIRED=true
AML_SERVICE_KEY=

CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=change-me-clickhouse

# Keyless demo endpoint; production requires verified history and trace coverage.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
ETH_EXPECTED_CHAIN_ID=1
ETH_NETWORK_ID=eip155:1
ETH_START_BLOCK=0
ETH_FINALITY_TAG=finalized
ETH_POLL_INTERVAL_SECONDS=12
ETH_INGESTION_BATCH_MAX_ROWS=10000
ETH_RPC_PROVIDER=custom
ETH_RPC_MAX_RETRIES=5
ETH_RPC_RETRY_BASE_DELAY_MS=500
ETH_REQUEST_DELAY_MS=100
ETH_TRACE_MODE=auto
ETH_PROTOCOL_REGISTRY_REFRESH_BLOCKS=100
ETH_TOKEN_METADATA_POLL_SECONDS=30
ETH_TOKEN_METADATA_BATCH_SIZE=100
ETH_TOKEN_METADATA_MAX_ATTEMPTS=5
ETH_RISK_ENGINE_ENABLED=false
ETH_RISK_POLICY_VERSION=ethereum_evidence_policy_v1
ETH_ANALYTICS_INTERVAL_SECONDS=86400
ETH_EXPOSURE_MAX_HOPS=5
ETH_EXPOSURE_HOP_DECAY=0.65
ETH_EXPOSURE_TIME_HALF_LIFE_DAYS=365
ETH_EXPOSURE_MAX_PATHS_PER_SUBJECT=3
RPC_TIMEOUT_SECONDS=120

ETH_GRAPH_MAX_EDGES=20000
ETHEREUM_APP_IMAGE_TAG=local
RUST_LOG=info
RUST_BACKTRACE=1
TZ=Asia/Tehran
