# Main VM: Gateway, Analytical Node and the only Neo4j. RPC/ClickHouse secrets stay on chain VMs.
NEO4J_PASSWORD=
AML_GRAPH_TTL_HOURS=24
AML_NEO4J_HTTP_PORT=7474
AML_NEO4J_BOLT_PORT=7687
AML_BIND_ADDRESS=10.20.0.10
AML_PORT=8080
# Use "off" for local development. Use a single-word realm such as AML-Restricted
# after creating AML_HTPASSWD_FILE for a shared or production deployment.
AML_BASIC_AUTH_REALM=off
AML_HTPASSWD_FILE=./gateway/auth/disabled.htpasswd
# Must match AML_SERVICE_KEY on every enabled network VM. Use at least 32 random characters.
AML_SERVICE_KEY=
# Origin only (scheme + host + optional port); no trailing slash, path or credentials.
# Linux multi-VM deployment: replace these example IPs with reachable chain VM addresses.
# For a single Linux host, use its private IP and bind both APIs to that IP.
AML_TRON_UPSTREAM=http://10.20.0.21:4001
AML_ETHEREUM_UPSTREAM=http://10.20.0.22:5001
AML_BSC_UPSTREAM=http://10.20.0.23:6001
