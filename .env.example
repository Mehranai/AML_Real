# Gateway only. Keep RPC keys and database passwords in each network's own .env.
AML_BIND_ADDRESS=127.0.0.1
AML_PORT=8080
# Use "off" for local development. Use a single-word realm such as AML-Restricted
# after creating AML_HTPASSWD_FILE for a shared or production deployment.
AML_BASIC_AUTH_REALM=off
AML_HTPASSWD_FILE=./gateway/auth/disabled.htpasswd
# Must match AML_SERVICE_KEY on every enabled network VM. Use at least 32 random characters.
AML_SERVICE_KEY=
# Origin only (scheme + host + optional port); no trailing slash, path or credentials.
# Docker Desktop: published API ports on this computer.
# Separate machines: replace host.docker.internal with each API's private DNS/IP.
AML_TRON_UPSTREAM=http://host.docker.internal:4001
AML_ETHEREUM_UPSTREAM=http://host.docker.internal:5001
