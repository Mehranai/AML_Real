# Bitcoin VM: independent Rust adapter and isolated ClickHouse database.
BITCOIN_API_BIND_ADDRESS=10.20.0.24
BITCOIN_API_PORT=6101
BITCOIN_APP_IMAGE_TAG=local
DATABASE_BIND_ADDRESS=127.0.0.1
BITCOIN_CLICKHOUSE_HTTP_PORT=48123
BITCOIN_CLICKHOUSE_NATIVE_PORT=49000
BITCOIN_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:23.8
BITCOIN_CLICKHOUSE_URL=http://clickhouse:8123
BITCOIN_CLICKHOUSE_DATABASE=bitcoin_aml
BITCOIN_CLICKHOUSE_USER=bitcoin_admin
BITCOIN_CLICKHOUSE_PASSWORD=
# Match the main VM; at least 32 characters.
AML_SERVICE_KEY=
# Unpruned Bitcoin Core mainnet RPC, reachable from the Bitcoin container.
# Set rpcbind/rpcallowip narrowly on Core. Keep credentials separate from the URL.
BITCOIN_RPC_URL=http://host.docker.internal:8332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_RPC_TIMEOUT_SECONDS=60
# Explicit trusted origins only; same RPC credentials are sent to each configured endpoint.
BITCOIN_RPC_FALLBACK_URLS=
BITCOIN_RPC_MAX_ATTEMPTS=4
BITCOIN_RPC_RETRY_BASE_MS=250
BITCOIN_RPC_REQUEST_INTERVAL_MS=50
BITCOIN_RPC_MAX_RESPONSE_BYTES=67108864
BITCOIN_RPC_BATCH_ENABLED=true
BITCOIN_BLOCK_BATCH_SIZE=2
BITCOIN_BLOCK_FETCH_CONCURRENCY=2
BITCOIN_PREVOUT_BATCH_SIZE=128
BITCOIN_PREVOUT_CONCURRENCY=2
BITCOIN_MAX_PREVOUTS_PER_BLOCK=100000
BITCOIN_MAX_RESOLVED_BYTES=67108864
BITCOIN_FALLBACK_COOLDOWN_SECONDS=30
# Compose supplies /var/lock/bitcoin on the stable per-VM lock volume.
# Native mutating CLI commands MUST explicitly set BITCOIN_WRITER_LOCK_DIR
# to the same shared lock filesystem; they fail when this setting is absent.
# Core verbosity 3 provides spent prevouts when undo data exists.
# Fallback getrawtransaction requires txindex=1 when the prevout is not already stored.
BITCOIN_BLOCK_VERBOSITY=3
BITCOIN_START_BLOCK=0
BITCOIN_END_BLOCK=
BITCOIN_CONFIRMATIONS=6
BITCOIN_REORG_MAX_DEPTH=144
BITCOIN_POLL_SECONDS=10
# Persistent logical block/source attempts, independent of HTTP retry attempts.
BITCOIN_FAILURE_MAX_ATTEMPTS=10
BITCOIN_FAILURE_RETRY_SECONDS=1
# Read-only diagnostics: bash scripts/vm.sh bitcoin probe
# Uses the same RPC/range settings; exit 0=ready, 2=degraded, 1=unready.
# It samples configured boundaries, not the persisted database checkpoint.
