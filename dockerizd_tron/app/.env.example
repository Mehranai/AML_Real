# Copy this file to .env before the first Docker start.
# Replace all change-me values for any shared or production deployment.

# Host bindings and published ports
# API_BIND_ADDRESS may be the VM private IP. Keep DATABASE_BIND_ADDRESS on loopback.
API_BIND_ADDRESS=10.20.0.21
DATABASE_BIND_ADDRESS=127.0.0.1
TRON_API_PORT=4001
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000
# Neo4j is configured only in the main VM .env.

# Main-VM to chain-VM authentication. Enable in shared/production deployments.
AML_SERVICE_AUTH_REQUIRED=true
AML_SERVICE_KEY=

# Database credentials
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=change-me-clickhouse

# TRON source. Replace this URL with the local Full Node endpoint later.
TRON_RPC_URL=https://api.trongrid.io
TRON_API_KEY=

# Ingestion
SYNC_MODE=auto
TRON_START_BLOCK=0
TOTAL_TRON_TXS=0
TRON_POLL_INTERVAL_SECONDS=3
TRON_INGESTION_BATCH_MAX_ROWS=10000
TRON_INGESTION_FLUSH_INTERVAL_SECONDS=120
RPC_TIMEOUT_SECONDS=120
RPC_MAX_CONCURRENCY=10
TX_WORKER_CONCURRENCY=10

# Token metadata worker
TRON_METADATA_POLL_INTERVAL_SECONDS=5
TRON_METADATA_BATCH_SIZE=100
TRON_METADATA_MAX_ATTEMPTS=5
TRON_PROTOCOL_REGISTRY_REFRESH_BLOCKS=100

# Analysis defaults
TRON_EXPOSURE_MAX_HOPS=5

# Runtime
TZ=Asia/Tehran
RUST_BACKTRACE=1
TRON_APP_IMAGE_TAG=local
