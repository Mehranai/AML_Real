# RPC capability validation.
BSC_MODE=development
# Keyless demo endpoint; not a production capacity or history guarantee.
BSC_RPC_URL=https://bsc-rpc.publicnode.com
# Comma-separated, unique BSC endpoints. Every endpoint is chain/capability probed at startup;
# first attempts are round-robin distributed and retryable failures move to the next endpoint.
# BSC_RPC_FALLBACK_URLS=https://fallback-1.example,https://fallback-2.example
BSC_RPC_PROVIDER=custom
BSC_RPC_TIMEOUT_SECONDS=15
BSC_TRACE_MODE=auto
BSC_REQUIRE_BLOCK_RECEIPTS=false
BSC_TRACE_PROBE_BLOCK=0

# Reliable historical/follow ingestion.
BSC_SYNC_MODE=auto
BSC_RECEIPT_FETCH_MODE=auto
BSC_BLOCK_FETCH_CONCURRENCY=8
BSC_RECEIPT_CONCURRENCY=8
BSC_RPC_MAX_ATTEMPTS=4
BSC_RPC_RETRY_BASE_MILLIS=250
BSC_RPC_MAX_RESPONSE_BYTES=67108864
BSC_INGEST_MAX_BLOCKS_PER_RUN=1000
BSC_INGEST_BATCH_SIZE=100
BSC_POLL_INTERVAL_SECONDS=3
BSC_RPC_REQUEST_DELAY_MILLIS=0
BSC_REORG_MAX_DEPTH=128
BSC_FAILURE_MAX_ATTEMPTS=10
BSC_REPAIR_MAX_BLOCKS=1000
BSC_PROTOCOL_REGISTRY_REFRESH_BLOCKS=1000
# BSC_INGEST_START_BLOCK=123456
# BSC_INGEST_END_BLOCK=123500

# ClickHouse schema. Keep credentials out of Git and replace this example password.
BSC_CLICKHOUSE_URL=http://127.0.0.1:38123
BSC_CLICKHOUSE_USER=bsc_admin
BSC_CLICKHOUSE_PASSWORD=replace-with-a-strong-password
BSC_CLICKHOUSE_DATABASE=bsc_aml

# Host bindings used by Docker Compose.
DOCKER_BIND_ADDRESS=127.0.0.1
BSC_CLICKHOUSE_HTTP_PORT=38123
BSC_CLICKHOUSE_NATIVE_PORT=39000
# Offline image bundles may use the verified local tag instead of the default digest.
# BSC_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:23.8
RUST_LOG=info

# Shared key: identical to the main VM, generated by scripts/new-service-key.sh.
AML_SERVICE_KEY=
BSC_API_ADDR=127.0.0.1:6001
BSC_API_BIND_ADDRESS=10.20.0.23
BSC_API_PORT=6001

# Production requires all three capabilities and rejects weaker settings:
# BSC_MODE=production
# BSC_TRACE_MODE=required
# BSC_REQUIRE_BLOCK_RECEIPTS=true
